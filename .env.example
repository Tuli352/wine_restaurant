# Copy to .env and fill in. Never commit .env.
# mock = no real payments (default), sandbox = Daraja test, production = live money
MPESA_MODE=mock

# From https://developer.safaricom.co.ke (your app's keys)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Sandbox: shortcode 174379 and the passkey shown in the Daraja "Lipa na M-Pesa Online" simulator page.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=

# Paybill (default) or till number:
#   Paybill: MPESA_TXN_TYPE=CustomerPayBillOnline, PARTY_B not needed
#   Till:    MPESA_TXN_TYPE=CustomerBuyGoodsOnline, MPESA_SHORTCODE=store number, MPESA_PARTY_B=till number
MPESA_TXN_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=

# Public HTTPS address Safaricom can reach (e.g. an ngrok URL while testing), and a long random string.
# The callback URL becomes: <BASE>/api/mpesa/callback/<SECRET>
MPESA_CALLBACK_BASE=https://your-public-domain.example
MPESA_CALLBACK_SECRET=change-me-to-a-long-random-string
